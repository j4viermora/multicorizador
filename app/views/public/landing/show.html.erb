<% content_for(:head) do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.8.1/build/css/intlTelInput.min.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.8.1/build/js/intlTelInput.min.js"></script>
<% end %>
<style>
  .landing-root, .landing-root * { font-family: 'Poppins', sans-serif; }

  /* ── Hero: profundidad sutil sin perder identidad ── */
  .landing-hero {
    background:
      radial-gradient(ellipse 120% 80% at 50% -20%, oklch(0.38 0.09 260 / 0.45), transparent 55%),
      var(--wz-hero);
    position: relative;
    overflow: hidden;
  }

  .landing-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(oklch(1 0 0 / 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    opacity: 0.35;
  }

  /* ── Producer contact (fuera del hero) ── */
  .producer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.75rem;
    padding: 1rem 1.15rem;
  }

  @media (min-width: 640px) {
    .producer-contact {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .producer-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--wz-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .producer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--wz-ink-soft);
    transition: color 0.15s ease;
  }

  .producer-contact-link:hover { color: var(--wz-blue); }

  /* ── Trust bar ── */
  .trust-bar {
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.5rem;
  }
  .trust-provider {
    padding: 0.35rem 0.75rem;
    border-radius: 0.25rem;
    background: var(--wz-sand);
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--wz-ink-soft);
    white-space: nowrap;
  }

  /* ── Benefits ── */
  .benefit-card {
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.5rem;
    padding: 1rem;
    transition: border-color 0.15s ease;
  }
  .benefit-card:hover { border-color: var(--wz-blue); }
  .benefit-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.6rem;
  }

  /* ── Footer ── */
  .landing-footer {
    border-top: 1px solid var(--wz-border);
    color: var(--wz-ink-muted);
  }

  /* ── Stagger animations ── */
  @keyframes landing-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .land-in {
    animation: landing-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .land-in.d1 { animation-delay: 0.1s; }
  .land-in.d2 { animation-delay: 0.2s; }
  .land-in.d3 { animation-delay: 0.3s; }
  .land-in.d4 { animation-delay: 0.4s; }
  .land-in.d5 { animation-delay: 0.5s; }

  .qsearch-field .iti__tel-input { padding-right: 0 !important; }
  .iti__dropdown-content { font-family: 'Poppins', sans-serif; }

  /* ── Secciones de la landing ── */
  .sec { max-width: 72rem; margin-inline: auto; padding: 2.75rem 0; }
  /* Las franjas de fondo tocan los bordes del container, igual que el hero */
  .sec--tint {
    background: white;
    max-width: none;
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
  .sec--tint > .sec-inner { max-width: 72rem; margin-inline: auto; }

  .sec-title {
    font-size: 1.5rem;
    font-weight: 800;
    text-align: center;
    color: var(--wz-ink);
    letter-spacing: -0.01em;
  }
  .sec-sub {
    text-align: center;
    font-size: 0.9rem;
    color: var(--wz-ink-muted);
    margin-top: 0.35rem;
  }

  /* Proveedores */
  .prov-card {
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.6rem;
    padding: 1rem 0.75rem;
    text-align: center;
    transition: border-color 0.15s ease;
  }
  .prov-card:hover { border-color: var(--wz-blue); }
  .prov-logo {
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 auto 0.55rem;
    border-radius: 0.5rem;
    background: var(--wz-blue-light);
    color: var(--wz-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .prov-logo-img {
    height: 2.75rem;
    max-width: 8rem;
    margin: 0 auto 0.55rem;
    object-fit: contain;
  }

  /* Reseñas */
  .review-card {
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.6rem;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .review-stars { color: var(--wz-orange); font-size: 0.9rem; line-height: 1; }
  .review-body {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--wz-ink-soft);
    flex: 1;
  }
  .review-foot { font-size: 0.8rem; color: var(--wz-ink); }
  .review-source {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--wz-blue);
  }

  /* Pasos */
  .step-card { text-align: center; padding: 0 0.5rem; }
  .step-icon {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 0.75rem;
    border-radius: 0.75rem;
    background: var(--wz-blue-light);
    color: var(--wz-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    position: relative;
  }
  .step-num {
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--wz-orange);
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Categorías */
  .need-card {
    background: white;
    border: 1px solid var(--wz-border);
    border-radius: 0.6rem;
    padding: 1.15rem 0.75rem;
    text-align: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .need-card:hover { border-color: var(--wz-blue); }
  .need-card i { font-size: 1.85rem; color: var(--wz-blue); }
  .need-card p {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--wz-ink);
  }

  /* Acordeones (coberturas y FAQ) */
  .acc-item + .acc-item { border-top: 1px solid var(--wz-border); }
  .acc-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    padding: 1rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--wz-ink);
  }
  .acc-btn:hover { color: var(--wz-blue); }
  .acc-btn i { flex-shrink: 0; color: var(--wz-blue); }
  .acc-chevron { transition: transform 0.2s ease; }
  .acc-btn[aria-expanded="true"] .acc-chevron { transform: rotate(180deg); }
  .acc-body {
    padding: 0 0.25rem 1rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--wz-ink-soft);
  }

  /* Footer */
  .site-footer {
    background: var(--wz-hero);
    color: white;
    margin: 2.5rem -1rem -2rem;
    padding: 2.5rem 1rem 1.75rem;
  }
  .site-footer a { color: oklch(0.85 0.03 215); }
  .site-footer a:hover { color: white; }
  .site-footer-inner { max-width: 72rem; margin-inline: auto; }
  .site-footer-head {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: oklch(0.7 0.04 215);
    margin-bottom: 0.75rem;
  }
</style>
<div class="landing-root">
  <%# ══════════════════════════════════════════════ %>
  <%# HERO + COTIZADOR                              %>
  <%# ══════════════════════════════════════════════ %>
  <div class="landing-hero -mx-4 -mt-8 px-4 pt-6 pb-12 md:pt-8 md:pb-16 relative">
    <div class="max-w-3xl lg:max-w-6xl mx-auto relative z-10">
      <%# Logo %>
      <div class="mb-6 land-in">
        <%= image_tag "ruka-logo-white.svg", alt: "Ruka Assistance", class: "h-16 md:h-20 w-auto" %>
      </div>

      <%# Título %>
      <div class="mb-4 land-in">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-[1.15]">
          Buscador de seguros de viaje
        </h1>
        <p class="text-base md:text-lg font-bold mt-1" style="color: oklch(0.88 0.03 215);">
          Compará todas las coberturas y elegí la que te sirve
        </p>
      </div>

      <%# ── Buscador: una sola fila dentro del marco ── %>
      <div class="qsearch land-in d2" data-controller="quote-form">
        <%= simple_form_for @quote, url: public_landing_path(@company.slug, ref: params[:ref]),
            method: :post,
            html: { novalidate: true, data: { turbo: false, action: "submit->quote-form#validate" } } do |f| %>

          <%= f.hidden_field :trip_type, value: "single" %>
          <%= f.hidden_field :travelers_count, value: 0, data: { quote_form_target: "count" } %>

          <div class="qsearch__frame">
            <div class="qsearch__bar">
              <%# País de origen %>
              <div class="qsearch-field ac-wrapper"
                   data-controller="country-autocomplete"
                   data-country-autocomplete-items-value="<%= countries_autocomplete_data %>">
                <label class="qsearch-label" for="quote_origin">País de origen</label>
                <div class="qsearch-control">
                  <i class="ti ti-map-pin"></i>
                  <%= f.input :origin, label: false, wrapper: :qbar_plain,
                      placeholder: "Elegí el país",
                      input_html: {
                        required: true, autocomplete: "off",
                        data: {
                          country_autocomplete_target: "input",
                          action: "input->country-autocomplete#filter focus->country-autocomplete#open keydown->country-autocomplete#keydown focus->quote-form#clearError"
                        }
                      } %>
                </div>
                <ul data-country-autocomplete-target="list" class="ac-list hidden"></ul>
              </div>

              <%# Destino %>
              <div class="qsearch-field ac-wrapper"
                   data-controller="country-autocomplete"
                   data-country-autocomplete-items-value="<%= countries_autocomplete_data %>">
                <label class="qsearch-label" for="quote_destination">Destino</label>
                <div class="qsearch-control">
                  <i class="ti ti-plane-tilt"></i>
                  <%= f.input :destination, label: false, wrapper: :qbar_plain,
                      placeholder: "¿A dónde vas?",
                      input_html: {
                        required: true, autocomplete: "off",
                        data: {
                          country_autocomplete_target: "input",
                          action: "input->country-autocomplete#filter focus->country-autocomplete#open keydown->country-autocomplete#keydown focus->quote-form#clearError"
                        }
                      } %>
                </div>
                <ul data-country-autocomplete-target="list" class="ac-list hidden"></ul>
              </div>

              <%# Edades: una casilla por pasajero, (+) agrega la siguiente %>
              <div class="qsearch-field qsearch-field--ages">
                <span class="qsearch-label">
                  Edades
                  <button type="button" class="qsearch-add" aria-label="Agregar pasajero"
                          data-quote-form-target="addAge"
                          data-action="quote-form#addAge">
                    <i class="ti ti-plus"></i>
                  </button>
                </span>
                <div class="qsearch-ages" data-quote-form-target="ages">
                  <% 6.times do |i| %>
                    <div class="qsearch-age" data-age-field>
                      <input type="number" name="quote[metadata][ages][]" min="0" max="120"
                             inputmode="numeric"
                             aria-label="Edad del pasajero <%= i + 1 %>"
                             data-action="input->quote-form#sync focus->quote-form#clearError">
                    </div>
                  <% end %>
                </div>
              </div>

              <%# Fecha de viaje %>
              <div class="qsearch-field">
                <span class="qsearch-label">Fecha de viaje</span>
                <div class="qsearch-control">
                  <i class="ti ti-calendar-event"></i>
                  <div class="qsearch-dates">
                    <%= f.input :departure_date, label: false, as: :datepicker, wrapper: :qbar_plain,
                        placeholder: "Salida",
                        input_html: { required: true,
                                      data: { datepicker_min_value: Date.today.iso8601,
                                              action: "focus->quote-form#clearError" } } %>
                    <i class="ti ti-arrow-narrow-right qsearch-dates-sep"></i>
                    <%= f.input :return_date, label: false, as: :datepicker, wrapper: :qbar_plain,
                        placeholder: "Regreso",
                        input_html: { data: { datepicker_min_value: Date.today.iso8601 } } %>
                  </div>
                </div>
              </div>

              <%# WhatsApp %>
              <div class="qsearch-field">
                <label class="qsearch-label" for="phone-input">WhatsApp</label>
                <div class="qsearch-control">
                  <input type="tel" id="phone-input" placeholder="11 1234-5678" autocomplete="tel">
                  <input type="hidden" name="quote[metadata][phone]" id="phone-full-value">
                </div>
              </div>

              <%# Email %>
              <div class="qsearch-field">
                <label class="qsearch-label" for="quote-email">Email</label>
                <div class="qsearch-control">
                  <i class="ti ti-mail"></i>
                  <input type="email" id="quote-email" name="quote[metadata][email]"
                         placeholder="tu@email.com" required autocomplete="email"
                         data-action="focus->quote-form#clearError">
                </div>
              </div>

              <button type="submit" class="qsearch-submit">Cotizar</button>
            </div>
          </div>
        <% end %>

        <p class="qsearch__note land-in d3">
          Cotización sin costo y sin compromiso &middot; Resultados en segundos
        </p>
      </div>
    </div>
  </div>

  <%= render "public/landing/providers", providers: @providers %>
  <%= render "public/landing/benefits" %>
  <%= render "public/landing/steps" %>
  <%= render "public/landing/coverages" %>
  <%= render "public/landing/needs" %>
  <%= render "public/landing/reviews", testimonials: @testimonials %>
  <%= render "public/landing/faq" %>
  <%= render "public/landing/advisor", producer: @producer, ref: params[:ref] %>
  <%= render "public/landing/footer", company: @company, links: @footer_links %>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const phoneInput = document.getElementById("phone-input")
    const hiddenInput = document.getElementById("phone-full-value")
    if (!phoneInput || typeof intlTelInput === "undefined") return

    const iti = intlTelInput(phoneInput, {
      initialCountry: "ar",
      preferredCountries: ["ar", "br", "cl", "co", "mx", "uy", "py", "pe", "us", "es"],
      separateDialCode: false,
      nationalMode: false,
      useFullscreenPopup: false,
      loadUtilsOnInit: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.8.1/build/js/utils.js",
    })

    const form = phoneInput.closest("form")
    if (form) {
      form.addEventListener("submit", function () {
        hiddenInput.value = iti.getNumber()
      })
    }
  })
</script>
